# Скопируйте этот файл в .env и установите нужные значения

# --- Production (FirstVDS + DuckDNS) ---
# DuckDNS: pulsetok → 83.136.233.93
DOMAIN=pulsetok.duckdns.org
CORS_ORIGINS=https://pulsetok.duckdns.org

# --- Database (TimescaleDB) ---
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=myhouse
DB_PORT=5432
DB_URL=postgresql://postgres:your_secure_password_here@postgres:5432/myhouse

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=8000
ML_SERVICE_URL=http://ml:8002

# --- Frontend (Docker prod использует /api/v1; для npm run dev — localhost) ---
VITE_API_URL=http://localhost:8000/api/v1

# --- Redis (только --profile dev, FastAPI не использует) ---
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_URL=redis://:your_redis_password_here@redis:6379
